# [Hotkey/PrevPage]
# 0=Up

# [Hotkey/NextPage]
# 0=Down

# [Hotkey/PrevCandidate]
# 0=Shift+Tab

# [Hotkey/NextCandidate]
# 0=Tab

# [Hotkey/TogglePreedit]
# 0=Control+Alt+P

# [Behavior]
# Kích hoạt kiểu gõ theo mặc định
# ActiveByDefault=False
# Reset state on Focus In
# resetStateWhenFocusIn=No
# Chia Sẻ Trạng Thái Nhập
ShareInputState=All
# Show preedit in application
# PreeditEnabledByDefault=True
# Hiển thị thông tin Kiểu Gõ khi chuyển đổi Kiểu Gõ
