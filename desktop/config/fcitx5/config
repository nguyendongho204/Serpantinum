# [Hotkey]
# Enumerate when holding modifier of Toggle key
# EnumerateWithTriggerKeys=True
# Consume redundant Activate/Deactivate key
# ConsumeRedundantActivateKeys=False
# Liệt kê phương thức nhập sau
# EnumerateForwardKeys=
# Liệt kê phương thức nhập liệu trước
# EnumerateBackwardKeys=
# Bỏ qua kiểu gõ đầu tiên trong khi liệt kê
# EnumerateSkipFirst=False
# Time limit in milliseconds for triggering modifier key shortcuts
